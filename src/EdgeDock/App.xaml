<Application
    x:Class="EdgeDock.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="EdgeDockPurple">#FF9B7CFF</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource EdgeDockPurple}" />
            <SolidColorBrush x:Key="ShellBrush" Color="#FF111016" />
            <SolidColorBrush x:Key="PanelBrush" Color="#FF1A1821" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#FFC8C2D4" />
            <Style TargetType="Button">
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="MinWidth" Value="52" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
