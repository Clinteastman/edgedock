<UserControl x:Class="EdgeDock.Controls.PcShortcutsWidget" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Padding="20" CornerRadius="14" Background="#B31A1821"><StackPanel Spacing="12"><TextBlock Text="PC shortcuts" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Open Windows Settings" Foreground="{StaticResource MutedTextBrush}"/><Grid ColumnSpacing="10" RowSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Button Content="Sound" Click="Sound_Click"/><Button Grid.Column="1" Content="Display" Click="Display_Click"/><Button Grid.Row="1" Content="Bluetooth" Click="Bluetooth_Click"/><Button Grid.Row="1" Grid.Column="1" Content="Network" Click="Network_Click"/></Grid></StackPanel></Border>
</UserControl>
