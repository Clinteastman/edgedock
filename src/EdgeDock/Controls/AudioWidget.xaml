<UserControl
    x:Class="EdgeDock.Controls.AudioWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Padding="20,16" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="PC audio" FontSize="20" FontWeight="SemiBold" />

            <TextBlock x:Name="EndpointName" Grid.Row="1" Text="Finding playback device"
                       Foreground="{StaticResource MutedTextBrush}" FontSize="16"
                       TextTrimming="CharacterEllipsis" MaxLines="2" />

            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="5"
                        MinHeight="52" VerticalAlignment="Center" IsEnabled="False" AutomationProperties.Name="System volume"
                        PointerPressed="VolumeSlider_PointerPressed" PointerReleased="VolumeSlider_PointerReleased"
                        PointerCaptureLost="VolumeSlider_PointerCaptureLost" ValueChanged="VolumeSlider_ValueChanged" />
                <TextBlock x:Name="VolumeText" Grid.Column="1" Text="--%" FontSize="16" VerticalAlignment="Center" />
            </Grid>

            <ToggleSwitch x:Name="MuteToggle" Grid.Row="3" Header="Mute sound" OffContent="Sound on" OnContent="Muted"
                          MinHeight="52" IsEnabled="False" AutomationProperties.Name="Mute system audio"
                          Toggled="MuteToggle_Toggled" />

            <TextBlock x:Name="AudioStatus" Grid.Row="4" Foreground="#FFFFC2C7" FontSize="14"
                       TextWrapping="Wrap" Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
