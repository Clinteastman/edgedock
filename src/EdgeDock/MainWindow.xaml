<Window
    x:Class="EdgeDock.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="EdgeDock">

    <Grid x:Name="Root" Background="{StaticResource ShellBrush}" KeyDown="Root_KeyDown" SizeChanged="Root_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <WebView2 x:Name="DashboardWebView"
                      DefaultBackgroundColor="#111016"
                      NavigationStarting="DashboardWebView_NavigationStarting"
                      NavigationCompleted="DashboardWebView_NavigationCompleted" />

            <Grid x:Name="SetupState" Background="{StaticResource ShellBrush}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Spacing="14">
                    <SymbolIcon Symbol="World" Foreground="{StaticResource AccentBrush}" Width="48" Height="48" />
                    <TextBlock Text="Choose a dashboard" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Add the web address for the page you want EdgeDock to show. Your sign-in stays on this computer."
                               Foreground="{StaticResource MutedTextBrush}" FontSize="18" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Content="Open settings" HorizontalAlignment="Center" Click="OpenSettings_Click" />
                </StackPanel>
            </Grid>

            <Grid x:Name="WebStatusState" Background="#E6111016" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620" Spacing="12">
                    <ProgressRing x:Name="LoadingRing" IsActive="False" Width="42" Height="42" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="WebStatusTitle" Text="Loading dashboard" FontSize="26" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock x:Name="WebStatusMessage" Foreground="{StaticResource MutedTextBrush}" FontSize="17" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button x:Name="RetryButton" Content="Try again" HorizontalAlignment="Center" Click="Reload_Click" Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <Button x:Name="ExitFullScreenButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18"
                    Click="ExitFullScreen_Click" Visibility="Collapsed" Background="#E6221E2C">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <SymbolIcon Symbol="BackToWindow" />
                    <TextBlock Text="Exit full screen" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Background="{StaticResource PanelBrush}" Padding="18,12" ColumnSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="TrackTitle" Text="Nothing playing" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TrackArtist" Text="Start audio in a Windows media app" Foreground="{StaticResource MutedTextBrush}"
                           FontSize="15" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="MediaStatus" Foreground="#FFFFC2C7" FontSize="13" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="PreviousButton" AutomationProperties.Name="Previous track" ToolTipService.ToolTip="Previous track"
                        IsEnabled="False" Click="Previous_Click"><SymbolIcon Symbol="Previous" /></Button>
                <Button x:Name="PlayPauseButton" AutomationProperties.Name="Play" ToolTipService.ToolTip="Play"
                        IsEnabled="False" Click="PlayPause_Click"><SymbolIcon x:Name="PlayPauseIcon" Symbol="Play" /></Button>
                <Button x:Name="NextButton" AutomationProperties.Name="Next track" ToolTipService.ToolTip="Next track"
                        IsEnabled="False" Click="Next_Click"><SymbolIcon Symbol="Next" /></Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="OpenSettings_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Setting" /><TextBlock Text="Settings" /></StackPanel>
                </Button>
                <Button x:Name="ReloadButton" Click="Reload_Click" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Refresh" /><TextBlock Text="Reload" /></StackPanel>
                </Button>
                <Button x:Name="FullScreenButton" Click="FullScreen_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="FullScreen" /><TextBlock Text="Full screen" /></StackPanel>
                </Button>
            </StackPanel>

            <Border x:Name="SettingsPanel" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" Padding="12"
                    Background="#FF24202E" CornerRadius="10" Visibility="Collapsed">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Dashboard web address" FontWeight="SemiBold" />
                        <TextBox x:Name="UrlTextBox" PlaceholderText="https://example.com" FontSize="17"
                                 AutomationProperties.Name="Dashboard web address" KeyDown="UrlTextBox_KeyDown" />
                        <TextBlock x:Name="UrlErrorText" Foreground="#FFFFC2C7" Visibility="Collapsed" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Save and open" VerticalAlignment="Bottom" Click="SaveSettings_Click" />
                    <Button Grid.Column="2" Content="Cancel" VerticalAlignment="Bottom" Click="CancelSettings_Click" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
